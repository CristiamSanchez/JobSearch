# JobSearch AI — environment configuration template.
#
# Copy this file to `.env` and fill in real values for local development.
# `.env` is git-ignored: never commit real secrets.
# Real environment variables always override values defined in `.env`.

# Runtime environment label: development | staging | production
APP_ENV=development

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Gmail job intake (Phases 4A/6A) — configuration only, NEVER credentials.
# Used by the manual sync: `python -m jobsearch.gmail_sync` (read-only).
# ---------------------------------------------------------------------------
# Gmail search query used for intake. Plain Gmail syntax; change it here to
# widen or narrow the search without touching Python code.
#   Examples: newer_than:7d   |   after:2026/09/01   |   newer_than:30d is:unread
GMAIL_QUERY=newer_than:7d

# OAuth client secrets file (downloaded from the Google Cloud console as a
# "Desktop app" OAuth client ID). Keep this file OUTSIDE Git — the default
# path is under secrets/, which is git-ignored. No key, secret, or token
# belongs in this file.
GMAIL_CREDENTIALS_FILE=secrets/gmail_credentials.json

# Cached OAuth user token (created on first login; also git-ignored).
GMAIL_TOKEN_FILE=secrets/gmail_token.json

# Maximum number of messages returned per search (positive integer).
GMAIL_MAX_RESULTS=50

# ---------------------------------------------------------------------------
# AI extraction (Phase 6A) — used by the manual sync to structure job emails.
# ---------------------------------------------------------------------------
# API key for the AI endpoint. Leave EMPTY here and set it in your local
# `.env` (git-ignored) or the real environment — never commit a real key.
AI_API_KEY=

# OpenAI-compatible chat-completions base URL (any compliant endpoint works;
# no SDK — the application uses standard-library HTTP only).
AI_BASE_URL=https://api.openai.com/v1

# Model used for extraction.
AI_MODEL=gpt-4o-mini

# Per-request timeout in seconds (1-600).
AI_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Career profile (Phase 6A) — analyzed against during the sync.
# ---------------------------------------------------------------------------
# Local JSON profile (edited by hand; see data/career_profile.json).
CAREER_PROFILE_PATH=data/career_profile.json

# ---------------------------------------------------------------------------
# Local persistence (Phase 4C) — SQLite database location, git-ignored.
# ---------------------------------------------------------------------------
# SQLite database file used by JobSearch AI. The file (and any journal/WAL
# sidecars) are git-ignored; tests never touch this file — they use
# in-memory or temporary databases.
DATABASE_PATH=data/jobsearch.db

# ---------------------------------------------------------------------------
# Local MVP dashboard (Phase 5) — loopback only, no authentication.
# ---------------------------------------------------------------------------
# Address and port for `python -m jobsearch.dashboard`. The dashboard is a
# local tool over SQLite; keep the host on loopback unless you know why
# you are exposing it.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
